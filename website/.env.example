# Server-side environment for /api (Vercel → Project → Settings → Environment Variables).
# NEVER prefix these with VITE_: nothing here may reach browser code.

# PostgreSQL (authoritative store). Use the provider's POOLED connection string (Supabase Supavisor
# port 6543, Neon "-pooler" host). POSTGRES_URL is also accepted (set by Vercel's Neon/Supabase integration).
DATABASE_URL=

# Upstash Redis (optional accelerator: rate limits, change-cursor cache, notifications).
# The Vercel Upstash/KV integration sets KV_REST_API_URL / KV_REST_API_TOKEN, which are accepted too.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# One-time team creation code (≥ 12 characters). Anyone with it can create a team + admin account
# via Settings → Team cloud sync → "First setup". Remove it after your team exists to disable sign-up.
NEUROMOVE_SETUP_CODE=

# Raw recording storage backend: postgres (default, bytea). 'object' is not implemented yet (501).
RAW_STORAGE=postgres
