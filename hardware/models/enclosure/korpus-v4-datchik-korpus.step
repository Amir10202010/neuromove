('Context #1','3D Context with UNIT and UNCERTAINTY') );
#4998 = ( LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.) );
#4999 = ( NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.) );
#5000 = ( NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT() );
#5001 = UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(2.E-07),#4998,
  'distance_accuracy_value','confusion accuracy');
#5002 = CONTEXT_DEPENDENT_SHAPE_REPRESENTATION(#5003,#5005);
#5003 = ( REPRESENTATION_RELATIONSHIP('','',#32,#10) 
REPRESENTATION_RELATIONSHIP_WITH_TRANSFORMATION(#5004) 
SHAPE_REPRESENTATION_RELATIONSHIP() );
#5004 = ITEM_DEFINED_TRANSFORMATION('','',#11,#15);
#5005 = PRODUCT_DEFINITION_SHAPE('Placement','Placement of an item',
  #5006);
#5006 = NEXT_ASSEMBLY_USAGE_OCCURRENCE('1','=>[0:1:1:2]','',#5,#27,$);
#5007 = PRODUCT_RELATED_PRODUCT_CATEGORY('part',$,(#29));
ENDSEC;
END-ISO-10303-21;
